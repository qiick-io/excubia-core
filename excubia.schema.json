{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/qiick-io/excubia-core/main/excubia.schema.json",
    "title": "Excubia configuration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "failOn": {
            "enum": ["critical", "high", "medium", "low", "none"]
        },
        "includeDev": {
            "type": "boolean"
        },
        "strict": {
            "type": "boolean",
            "description": "Same as --strict: exit 3 when a check was skipped because a data source failed (excubia push then does not send). --strict on the command line turns it on even when this key is false; the command line cannot turn it off. Default false."
        },
        "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "composer-stale": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "staleAfterMonths": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                },
                "php-eol": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "warnDaysBeforeEol": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "laravel-eol": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "warnDaysBeforeEol": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "node-eol": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "laravel-scheduler-heartbeat": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "staleAfterMinutes": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Warn when the scheduler heartbeat written by excubia:heartbeat is older than this many minutes. Default 10."
                        }
                    }
                },
                "laravel-failed-jobs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "highSeverityAfterHours": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Failed jobs warn at medium; at high once the oldest is older than this many hours. Default 24."
                        }
                    }
                }
            }
        },
        "ignore": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["checkId", "subject", "reason"],
                "properties": {
                    "checkId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "subject": {
                        "type": "string",
                        "minLength": 1
                    },
                    "advisoryId": {
                        "type": ["string", "null"]
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1
                    },
                    "until": {
                        "type": ["string", "null"],
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                }
            }
        },
        "cache": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "directory": {
                    "type": ["string", "null"]
                },
                "ttlHours": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "app": {
            "type": "object",
            "additionalProperties": false,
            "description": "Target of excubia push. EXCUBIA_APP_URL and EXCUBIA_APP_TOKEN override these keys. Prefer the environment for the token so it is not committed.",
            "properties": {
                "url": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Base URL of your excubia-app. HTTPS, or plain HTTP to localhost only."
                },
                "token": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Project push token from excubia-app."
                }
            }
        },
        "healthEndpoint": {
            "type": "object",
            "additionalProperties": false,
            "description": "Oh Dear-compatible health endpoint registered by the Laravel service provider (docs/health-endpoint.md). Off by default. The secret is read from the EXCUBIA_HEALTH_SECRET environment variable only; without it the route is not registered.",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Register the GET route. Default false."
                },
                "path": {
                    "type": "string",
                    "pattern": "^/?[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*/?$",
                    "description": "URL path of the route, relative to the app root. Default excubia/health."
                }
            }
        }
    }
}
