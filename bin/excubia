#!/usr/bin/env php
<?php

declare(strict_types=1);

use Qiick\Excubia\Console\CheckCommand;
use Qiick\Excubia\Console\ClearCacheCommand;
use Qiick\Excubia\Console\PushCommand;
use Qiick\Excubia\Services\HealthCheckRunnerService;
use Symfony\Component\Console\Application;

$autoload = null;

foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;

        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Composer autoload was not found. Run composer install.\n");

    exit(2);
}

require $autoload;

$application = new Application('Excubia', HealthCheckRunnerService::excubiaVersion());
// addCommands() exists on Symfony Console 7.2 through 8.x; add() was removed in 8.0.
$application->addCommands([new CheckCommand, new ClearCacheCommand, new PushCommand]);
exit($application->run());
