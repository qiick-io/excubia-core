{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/qiick-io/excubia-core/main/docs/report-schema.json",
    "title": "Excubia health report",
    "description": "Version 1 of the JSON report. Upgrade steps never affect the process exit code. advisoryId is optional and exists so an ignore rule can name one advisory. This schema covers --format=json only. --format=sarif follows the official SARIF 2.1.0 schema instead: one rule per checkId, one result per fail or warn finding (level error for critical and high, warning for medium, note for low and info), the Excubia severity, status, subject, advisoryId and evidenceUrl in result properties, the source manifest as a path relative to the scanned project, and a partialFingerprints entry built from checkId, subject and advisoryId. The upgrade plan is not part of the SARIF log.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "checks", "upgradePlan"],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "checks": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/check"
            }
        },
        "upgradePlan": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/upgradeStep"
            }
        }
    },
    "$defs": {
        "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkId", "name", "status", "findings"],
            "properties": {
                "checkId": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "enum": ["pass", "warn", "fail", "skipped"]
                },
                "findings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/finding"
                    }
                }
            }
        },
        "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkId", "severity", "status", "subject", "message", "fixHint", "evidenceUrl"],
            "properties": {
                "checkId": {
                    "type": "string"
                },
                "severity": {
                    "enum": ["critical", "high", "medium", "low", "info"]
                },
                "status": {
                    "enum": ["pass", "warn", "fail", "skipped"]
                },
                "subject": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "fixHint": {
                    "type": "string"
                },
                "evidenceUrl": {
                    "type": ["string", "null"]
                },
                "advisoryId": {
                    "type": ["string", "null"]
                },
                "skipReason": {
                    "description": "Present on skipped findings only. data-source-failure: a data source failed (network down and no cache, or an API error); --strict makes the command exit 3. offline: --offline found no cached response. not-applicable: the check does not apply to the project or is disabled. Neither offline nor not-applicable ever changes the exit code. Optional and additive, so schemaVersion stays 1.",
                    "enum": ["data-source-failure", "offline", "not-applicable"]
                }
            }
        },
        "upgradeStep": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepNumber", "message"],
            "properties": {
                "stepNumber": {
                    "type": "integer",
                    "minimum": 1
                },
                "message": {
                    "type": "string"
                }
            }
        }
    }
}
