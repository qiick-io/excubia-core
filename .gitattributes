# Dist archive (#235): Packagist installs get only what runs, plus LICENSE,
# README, CHANGELOG, excubia.schema.json and the public payload schemas in
# docs/*.json. Kept on purpose: src/, bin/, composer.json and
# brand/excubia/cli/banner.txt (read by the CLI banner). Everything below is
# for contributors, CI or the GitHub Action, which runs from a git checkout.

/.cursor                export-ignore
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/AGENTS.md              export-ignore
/CLAUDE.md              export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/action.yml             export-ignore
/composer.lock          export-ignore
/docs/*.md              export-ignore
/docs/guides            export-ignore
/phpstan-bootstrap.php  export-ignore
/phpstan.neon           export-ignore
/phpunit.xml            export-ignore
/pint.json              export-ignore
/qiick-standards.json   export-ignore
/scripts                export-ignore
/tests                  export-ignore
