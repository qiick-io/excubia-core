    "sarif": {
        "fingerprintKeys": [
            "excubiaFinding/v1"
        ],
        "sarifVersion": "2.1.0",
        "fingerprintWithAdvisory": "03196da51635453993c18e898509a354947c899a4d8ec76e05f8375d73546977",
        "fingerprintWithoutAdvisory": "a64ed5f54fc9897340cd1486ae0f8c2d0dd2d4a5e9e6e0127869c07a2ad778ab"
    },
    "exitCodes": {
        "NoFindingsAtOrAboveFailOn": 0,
        "FindingsAtOrAboveFailOn": 1,
        "UsageOrConfigurationError": 2,
        "DataSourceFailure": 3
    },
    "skipReasons": [
        "data-source-failure",
        "offline",
        "not-applicable"
    ],
    "cli": {
        "check": {
            "arguments": {
                "path": "optional"
            },
            "options": {
                "--format": "value required",
                "--output": "value required",
                "--fail-on": "value required",
                "--only": "value required",
                "--skip": "value required",
                "--no-dev": "flag",
                "--offline": "flag",
                "--no-cache": "flag",
                "--config": "value required",
                "--no-banner": "flag",
                "--strict": "flag"
            }
        },
        "push": {
            "arguments": {
                "path": "optional"
            },
            "options": {
                "--config": "value required",
                "--strict": "flag",
                "--deploy": "flag"
            }
        },
        "cache:clear": {
            "arguments": {
                "path": "optional"
            },
            "options": {
                "--config": "value required"
            }
        }
    },
    "artisan": {
        "commands": {
            "excubia:check": {
                "arguments": [],
                "options": {
                    "--format": "value optional",
                    "--output": "value optional",
                    "--fail-on": "value optional",
                    "--only": "value optional",
                    "--skip": "value optional",
                    "--no-dev": "flag",
                    "--offline": "flag",
                    "--no-cache": "flag",
                    "--config": "value optional",
                    "--no-banner": "flag",
                    "--strict": "flag"
                }
            },
            "excubia:push": {
                "arguments": [],
                "options": {
                    "--config": "value optional",
                    "--strict": "flag",
                    "--deploy": "flag"
                }
            },
            "excubia:push-runtime": {
                "arguments": [],
                "options": {
                    "--config": "value optional"
                }
            },
            "excubia:heartbeat": {
                "arguments": [],
                "options": []
            }
        },
        "heartbeatCacheKey": "excubia:scheduler-heartbeat",
        "workerHeartbeatCacheKeyPrefix": "excubia:worker-heartbeat:",
        "phpWebRuntimeCacheKey": "excubia:php-runtime:web"
    },
    "environmentVariables": [
        "EXCUBIA_APP_TOKEN",
        "EXCUBIA_APP_URL",
        "EXCUBIA_HEALTH_SECRET",
        "EXCUBIA_INSIDE_SCHEDULER",
        "EXCUBIA_RELEASE",
        "EXCUBIA_SERVER_NAME",
        "GITHUB_TOKEN"
    ],
    "push": {
        "protocolVersion": 1,
        "endpoints": {
            "report": "/api/reports",
            "runtime": "/api/runtime",
            "exceptions": "/api/exceptions"
        },
        "types": [
            "runtime",
            "exceptions"
        ],
        "runtimeBucketSeconds": 60,
        "runtimeHistogramBoundsMs": [
            5,
            10,
            25,
            50,
            100,
            250,
            500,
            1000,
            2500,
            5000,
            10000
        ]
    },
    "healthEndpoint": {
        "secretHeader": "oh-dear-health-check-secret",
        "secretVariable": "EXCUBIA_HEALTH_SECRET",
        "minimumSecretLength": 32,
        "defaultPath": "excubia/health",
        "responseKeys": [
            "finishedAt",
            "checkResults"
        ],
        "checkResultKeys": [
            "name",
            "label",
            "status",
            "notificationMessage",
            "shortSummary",
            "meta"
        ],
        "statuses": {
            "pass": "ok",
            "warn": "warning",
            "fail": "failed",
            "skipped": "skipped"
        },
        "crashed": [
            "excubia-run",
            "crashed"
        ],
        "notRunYet": [
            "excubia-run",
            "skipped"
        ]
    },
    "action": {
        "inputs": {
            "path": ".",
            "fail-on": "critical",
            "only": "",
            "skip": "",
            "github-token": "",
            "upload-sarif": "true",
            "php-version": "8.4"
        },
        "outputs": [
            "sarif-file",
            "exit-code"
        ]
    },
    "laravel": {
        "schedule": {
            "excubia:heartbeat": "* * * * *",
            "excubia:push-runtime": "* * * * *"
        },
        "routes": {
            "excubia.health": {
                "uri": "excubia/health",
                "methods": [
                    "GET",
                    "HEAD"
                ]
            }
        }
    }
}
