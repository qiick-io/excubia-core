{
    "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "Excubia",
                    "informationUri": "https://github.com/qiick-io/excubia-core",
                    "rules": [
                        {
                            "id": "php-eol",
                            "name": "PHP end of life",
