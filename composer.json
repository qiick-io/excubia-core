{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "qiick/excubia-core",
    "description": "Health checks for Laravel apps.",
    "type": "library",
    "keywords": [
        "excubia",
        "qiick",
        "laravel",
        "health-check",
        "composer",
        "cli",
        "security",
        "php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Qiick",
            "homepage": "https://qiick.io"
        }
    ],
    "homepage": "https://github.com/qiick-io/excubia-core",
    "support": {
        "issues": "https://github.com/qiick-io/excubia-core/issues",
        "source": "https://github.com/qiick-io/excubia-core"
    },
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.4",
        "symfony/console": "^7.2",
        "symfony/http-client": "^7.2"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.14",
        "larastan/larastan": "^3.3.1",
        "laravel/pint": "^1.30.4 <1.31.0",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1.11"
    },
    "bin": [
        "bin/excubia"
    ],
    "suggest": {
        "illuminate/console": "Required for the php artisan excubia:check alias on Laravel 11, 12, and 13.",
        "illuminate/support": "Required for the php artisan excubia:check alias on Laravel 11, 12, and 13."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qiick\\Excubia\\Laravel\\ExcubiaServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Qiick\\Excubia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qiick\\Excubia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
